[Unit]
Description=TAIFEX official daily tick to 5-minute futures reconstruction
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=stock-sync
Group=stock-sync
WorkingDirectory=/opt/taiwan_stock_analysis_platform
EnvironmentFile=/etc/taiwan-stock-analysis/sync.env
Environment=PYTHONPATH=/opt/taiwan_stock_analysis_platform/scripts
ExecStart=/opt/taiwan_stock_analysis_platform/.venv/bin/python scripts/update_futures_intraday_5m.py --lookback-days 45 --delay 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/taiwan_stock_analysis_platform/data_lake/staging/futures_intraday_5m
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
