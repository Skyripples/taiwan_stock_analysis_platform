[Unit]
Description=Check completed TAIFEX daily futures data three times per trading weekday

[Timer]
OnCalendar=Mon..Fri *-*-* 15:45:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 18:30:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 21:30:00 Asia/Taipei
AccuracySec=1min
RandomizedDelaySec=5min
Persistent=true
Unit=taiwan-stock-futures-update.service

[Install]
WantedBy=timers.target
